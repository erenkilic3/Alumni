# ==============================================================================
# Alumni Tracking System - Environment Variables Template
# ==============================================================================
# Copy this file to '.env' to configure your local development environment:
#   cp .env.example .env   OR   cp .example.env .env
#
# NOTE: The '.env' file contains private credentials and is ignored by Git.
# ==============================================================================

# --- 1. PostgreSQL Database Configuration ---
DB_USER=alumni_admin
DB_PASSWORD=alumni_secure_password
DB_NAME=alumni_db
DB_PORT=5432
DB_HOST=db
# Inside Docker containers, use @db:5432; for host development, use @localhost:5432
DATABASE_URL=postgresql://alumni_admin:alumni_secure_password@db:5432/alumni_db?schema=public

# --- 2. Backend API Configuration ---
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# --- 3. Frontend Web Application Configuration ---
VITE_API_URL=http://localhost:5001/api
