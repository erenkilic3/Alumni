{
  "name": "alumni-tracking-system",
  "version": "1.0.0",
  "description": "Alumni Tracking System - Fullstack Node.js, PostgreSQL, Docker",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server start",
    "client": "npm --prefix client start",
    "homepage": "node homepage.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "test:forgetting": "bash scripts/test-forgetting.sh",
    "db:generate": "npm --prefix server run db:generate",
    "migrate": "npm --prefix server run migrate",
    "migrate:up": "npm --prefix server run migrate:up",
    "migrate:down": "npm --prefix server run migrate:down",
    "migrate:status": "npm --prefix server run migrate:status",
    "migrate:reset": "npm --prefix server run migrate:reset",
    "seed": "npm --prefix server run seed",
    "seed:fresh": "npm --prefix server run seed:fresh",
    "seed:jobs": "npm --prefix server run seed:jobs",
    "db:seed": "npm --prefix server run db:seed"
  },
  "keywords": ["alumni", "nodejs", "postgresql", "docker", "express"],
  "author": "Eren Kılıç",
  "license": "MIT"
}
